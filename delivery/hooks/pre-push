#!/bin/sh

checker="$(git rev-parse --show-toplevel)/delivery/check.mjs" || exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref:$remote_ref" in
    '(delete):'*) continue ;;
    *:refs/heads/*) node "$checker" --advise "$1" "$remote_ref" "$local_sha" || : ;;
  esac
done
